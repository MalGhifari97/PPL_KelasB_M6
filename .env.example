PORT=5000

# ---------------------------------------------------------------------------
# Koneksi PostgreSQL (Supabase)
# Backend terhubung langsung ke Postgres memakai password database.
# API key Supabase (publishable/secret) TIDAK dipakai dan tidak perlu disimpan.
# ---------------------------------------------------------------------------
# Opsi 1 - Direct connection (butuh jaringan IPv6)
# DB_HOST=db.<project-ref>.supabase.co
# DB_USER=postgres
#
# Opsi 2 - Session Pooler (IPv4, pakai ini bila jaringan tidak mendukung IPv6)
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_USER=postgres.<project-ref>
#
# Catatan: Transaction Pooler (port 6543) tidak dipakai karena tidak mendukung
# prepared statement yang dibutuhkan driver pg.
# ---------------------------------------------------------------------------
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<password-database>
DB_NAME=postgres
DB_SSL=true
DB_POOL_MAX=10
